# Settings of the Compose stack. Copy this file to .env and edit it.
# Secrets are not here: ./secrets.sh makes them in ./secrets.

# The public host name. Caddy gets a certificate for it, and players open
# https://WATHENA_DOMAIN. Its DNS record must point at this machine, and
# ports 80 and 443 must be open. localhost uses Caddy's local authority.
WATHENA_DOMAIN=game.example.com

# Host ports for Caddy. Keep 80 and 443 for a public server: Let's
# Encrypt checks the domain on port 80, and the public URL drops :443.
WATHENA_HTTP_PORT=80
WATHENA_HTTPS_PORT=443

# The asset build, made with `wactl assets build` from your own game
# client (deploy/README.md, step 3). The default is the Docker volume
# named assets. An absolute folder path mounts that folder instead.
# WATHENA_ASSETS=/srv/wathena/assets

# waserver's config file, mounted read-only. Game settings, such as the
# maps and the start map, are there.
WATHENA_CONFIG=./waserver.yml

# The images to run. `docker compose build` makes them from this
# repository. Set registry images instead to skip the build.
WATHENA_IMAGE=wathena/waserver:local
WATHENA_TOOLS_IMAGE=wathena/wactl:local
# The version that waserver's log and `waserver version` and `wactl
# version` show, for images built here. For a release, set it to the
# output of `git describe --tags --always --dirty`.
WATHENA_VERSION=local

# The network between Caddy and waserver, and Caddy's fixed address on
# it. waserver believes X-Forwarded-For only from that address. Change
# them if the subnet is in use on this machine.
WATHENA_EDGE_SUBNET=172.30.80.0/24
WATHENA_PROXY_IP=172.30.80.10
