/bin/
/dist/
/client/dist/
*.wasm
# The benchmark's Lua build is committed, so running it needs no C compiler.
!/tools/luabench/wasm/lua.wasm
# The asset encoders are committed for the same reason.
!/internal/assets/texture/wasm/webp.wasm
!/internal/assets/sound/wasm/opus.wasm
# The client's pathfinding module, built from shared/path with TinyGo. CI
# rebuilds it and checks that it matches.
!/client/src/world/path.wasm

