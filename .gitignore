# Build output
/bin/
/dist/
/client/dist/
*.wasm
# The benchmark's Lua build is committed, so running it needs no C compiler.
!/tools/luabench/wasm/lua.wasm
# The asset encoders are committed for the same reason.
!/internal/assets/texture/wasm/webp.wasm
!/internal/assets/sound/wasm/opus.wasm
# Lua for builds without cgo. CI rebuilds it and checks that it matches.
!/internal/script/wasm/lua.wasm
# The client's pathfinding module, built from shared/path with TinyGo. CI
# rebuilds it and checks that it matches.
!/client/src/world/path.wasm
# The client's map generator, built from shared/gen with TinyGo and the
# procedural tag. scripts/check.sh rebuilds it and checks that it matches.
!/client/src/world/gen.wasm

# Go
/vendor/
coverage.out

# Node
node_modules/
.vite/

# Local data
/generated/
/data/
.env
# Secrets that deploy/compose/secrets.sh makes.
/deploy/compose/secrets/
# Files of scripts/compose-smoke.sh while it runs.
/deploy/compose/smoke.*/
*.log

# OS and editors
.DS_Store
.idea/
.vscode/

build/
# A waserver binary built at the repository root.
/waserver
